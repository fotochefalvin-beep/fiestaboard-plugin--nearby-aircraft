{
  "id": "nearby_aircraft",
  "name": "Nearby Aircraft",
  "version": "1.4.0",
  "description": "Display real-time nearby aircraft information from OpenSky Network API",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--nearby-aircraft",
  "documentation": "README.md",
  "icon": "plane",
  "category": "data",
  "min_refresh_seconds": 10,
  "supports_triggers": true,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable Nearby Aircraft",
        "default": false
      },
      "latitude": {
        "type": "number",
        "title": "Latitude",
        "description": "Center latitude for aircraft detection (-90 to 90)",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "title": "Longitude",
        "description": "Center longitude for aircraft detection (-180 to 180)",
        "minimum": -180,
        "maximum": 180
      },
      "radius_km": {
        "type": "number",
        "title": "Radius (km)",
        "description": "Search radius in kilometers",
        "default": 50,
        "minimum": 1
      },
      "client_id": {
        "type": "string",
        "title": "OpenSky Client ID (Optional)",
        "description": "Client ID for authenticated API access. Get from opensky-network.org"
      },
      "client_secret": {
        "type": "string",
        "title": "OpenSky Client Secret (Optional)",
        "description": "Client secret for authenticated API access",
        "ui:widget": "password"
      },
      "airlabs_api_key": {
        "type": "string",
        "title": "AirLabs API Key (Optional)",
        "description": "Looks up the real flight number on airlabs.co, also for alphanumeric call signs like BEL5EN. Without a key the flight number is derived from the call sign, which is empty or wrong for some flights.",
        "ui:widget": "password"
      },
      "max_aircraft": {
        "type": "integer",
        "title": "Max Aircraft",
        "description": "Maximum number of aircraft to display (1-24). The board actually rendered on may show fewer if it doesn't have enough rows.",
        "default": 4,
        "minimum": 1,
        "maximum": 24
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to fetch new data (minimum 10 seconds)",
        "default": 120,
        "minimum": 10
      },
      "trigger_call_signs": {
        "type": "string",
        "title": "Trigger: Call Signs (Optional)",
        "description": "Fire a trigger when an aircraft whose call sign starts with one of these passes, comma-separated (e.g. \"KLM, BAW\"). Leave every trigger rule empty to never fire a trigger.",
        "default": ""
      },
      "trigger_aircraft_types": {
        "type": "string",
        "title": "Trigger: Aircraft Types (Optional)",
        "description": "Comma-separated aircraft types, e.g. \"A380, 747\" (\"747\" matches \"747-8\") or ICAO designators like \"A388\". Case-insensitive.",
        "default": ""
      },
      "trigger_max_altitude_ft": {
        "type": "integer",
        "title": "Trigger: Max Altitude (ft, Optional)",
        "description": "Only aircraft at or below this altitude in feet.",
        "minimum": 0
      },
      "trigger_max_distance_km": {
        "type": "number",
        "title": "Trigger: Max Distance (km, Optional)",
        "description": "Only aircraft within this distance in kilometers.",
        "minimum": 0
      },
      "trigger_duration_seconds": {
        "type": "integer",
        "title": "Trigger Duration (seconds)",
        "description": "How long the trigger page stays on the board.",
        "default": 60,
        "minimum": 10
      },
      "trigger_cooldown_minutes": {
        "type": "integer",
        "title": "Trigger Cooldown (minutes)",
        "description": "Minimum time before the same aircraft can fire a trigger again.",
        "default": 30,
        "minimum": 0
      }
    },
    "required": [
      "latitude",
      "longitude"
    ]
  },
  "env_vars": [
    {
      "name": "NEARBY_AIRCRAFT_ENABLED",
      "required": false,
      "description": "Enable nearby aircraft feature",
      "default": "false"
    },
    {
      "name": "NEARBY_AIRCRAFT_LATITUDE",
      "required": false,
      "description": "Center latitude (-90 to 90)"
    },
    {
      "name": "NEARBY_AIRCRAFT_LONGITUDE",
      "required": false,
      "description": "Center longitude (-180 to 180)"
    },
    {
      "name": "NEARBY_AIRCRAFT_RADIUS_KM",
      "required": false,
      "description": "Search radius in kilometers (default: 50)",
      "default": "50"
    },
    {
      "name": "OPENSKY_CLIENT_ID",
      "required": false,
      "description": "OpenSky Network OAuth2 client ID"
    },
    {
      "name": "OPENSKY_CLIENT_SECRET",
      "required": false,
      "description": "OpenSky Network OAuth2 client secret"
    },
    {
      "name": "NEARBY_AIRCRAFT_MAX_COUNT",
      "required": false,
      "description": "Maximum aircraft to display (default: 4)",
      "default": "4"
    },
    {
      "name": "NEARBY_AIRCRAFT_REFRESH_SECONDS",
      "required": false,
      "description": "Refresh interval in seconds (default: 120)",
      "default": "120"
    }
  ],
  "variables": {
    "groups": {
      "closest": {
        "label": "Closest Aircraft"
      },
      "display": {
        "label": "Display"
      }
    },
    "simple": {
      "call_sign": {
        "description": "Call sign of closest aircraft",
        "type": "string",
        "max_length": 8,
        "group": "closest",
        "example": "UAL1234"
      },
      "altitude": {
        "description": "Altitude of closest aircraft in feet",
        "type": "number",
        "max_length": 6,
        "group": "closest",
        "example": "35000"
      },
      "ground_speed": {
        "description": "Ground speed of closest aircraft in knots",
        "type": "number",
        "max_length": 4,
        "group": "closest",
        "example": "450"
      },
      "squawk": {
        "description": "Transponder squawk code",
        "type": "string",
        "max_length": 4,
        "group": "closest",
        "example": "1200"
      },
      "formatted": {
        "description": "Pre-formatted aircraft display",
        "type": "string",
        "max_length": 22,
        "group": "display",
        "example": "UAL1234 35000ft 450kt"
      },
      "headers": {
        "description": "Column headers for display",
        "type": "string",
        "max_length": 22,
        "group": "display",
        "example": "CALL  ALT  SPD  DIST"
      },
      "aircraft_count": {
        "description": "Number of nearby aircraft detected",
        "type": "number",
        "max_length": 2,
        "group": "display",
        "example": "4"
      },
      "last_updated": {
        "description": "Timestamp of last data fetch",
        "type": "string",
        "max_length": 25,
        "group": "display",
        "example": "2025-03-15 10:00:00"
      },
      "origin": {
        "description": "Origin airport of closest aircraft (IATA/ICAO code)",
        "type": "string",
        "max_length": 4,
        "group": "closest",
        "example": "JFK"
      },
      "destination": {
        "description": "Destination airport of closest aircraft (IATA/ICAO code)",
        "type": "string",
        "max_length": 4,
        "group": "closest",
        "example": "LAX"
      },
      "flight_number": {
        "description": "Flight number (IATA) of closest aircraft; from AirLabs when a key is set, else derived from a numeric call sign (empty for alphanumeric ones)",
        "type": "string",
        "max_length": 7,
        "group": "closest",
        "example": "UA1234"
      },
      "aircraft_type": {
        "description": "Aircraft type of closest aircraft (e.g. 737-800; uncommon types show the ICAO code)",
        "type": "string",
        "max_length": 11,
        "group": "closest",
        "example": "737-800"
      }
    },
    "arrays": {
      "aircraft": {
        "label_field": "call_sign",
        "item_fields": [
          "icao24",
          "call_sign",
          "altitude",
          "ground_speed",
          "squawk",
          "origin",
          "destination",
          "flight_number",
          "aircraft_type",
          "latitude",
          "longitude",
          "distance_km",
          "formatted"
        ]
      }
    }
  },
  "max_lengths": {
    "aircraft.*.icao24": 6,
    "aircraft.*.call_sign": 8,
    "aircraft.*.altitude": 6,
    "aircraft.*.ground_speed": 4,
    "aircraft.*.squawk": 4,
    "aircraft.*.formatted": 22,
    "aircraft.*.distance_km": 6,
    "aircraft.*.origin": 4,
    "aircraft.*.destination": 4,
    "aircraft.*.flight_number": 7,
    "aircraft.*.aircraft_type": 11
  },
  "fiestaboard_version": ">=2.10.0",
  "screenshots": [
    {
      "src": "docs/board-display.png",
      "alt": "Nearby Aircraft displayed on a Vestaboard",
      "caption": "Display real-time nearby aircraft information from OpenSky Network API",
      "primary": true
    }
  ],
  "teaser": "UAL1234 35000FT",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}{67}",
        "UAL 1532 B738 12000 FT",
        "SWA 445  B737  8200 FT",
        "DAL 892  A321 15400 FT",
        "AAL 210  B789 22100 FT",
        "SKW 5412 E175  6500 FT"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{67}{67} OVERHEAD",
        "UAL1234 35000FT",
        "4 TRACKED"
      ]
    },
    {
      "label": "Note Array (2x2)",
      "device_type": "note_array",
      "notes_wide": 2,
      "notes_tall": 2,
      "rows": [
        "      NEARBY AIRCRAFT",
        "CALLSGN    ALT    SPD  SQWK",
        "UAL1532  12000FT 340KT 4610",
        "SWA445    8200FT 310KT 1200",
        "DAL892   15400FT 410KT 5521",
        "4 AIRCRAFT TRACKED OVERHEAD"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "Nearby Aircraft Demo",
      "template": [
        "Nearby Aircraft",
        "{{nearby_aircraft.headers}}",
        "{{nearby_aircraft.formatted}}",
        "",
        "",
        "Tracked {{nearby_aircraft.aircraft_count}}"
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "Nearby Aircraft (Note)",
      "template": [
        "NEARBY AIRCRAFT",
        "{{nearby_aircraft.formatted}}",
        "{{nearby_aircraft.aircraft_count}} TRACKED"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
